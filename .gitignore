# Registry and database
registry.sqlite
*.sqlite
*.sqlite3

# Secrets and credentials
.env
.env.*
!.env.example
.secrets/
**/.secrets/
**/auth.json
**/credentials.json
**/tokens.json
*.pem
*.key
*.pfx
**/.netrc

# Local overrides - user-specific active configuration
*.local.json
*.local.jsonc
opencode.local.json
opencode.local.jsonc
local.settings.json
tui.json

# OpenCode runtime state
sessions/
logs/
cache/
.cache/
tmp/
working/
backups/
*.log
*.pid
*.lock
**/.opencode/sessions/
**/.opencode/logs/
**/.opencode/cache/

# Intelligence generated state
**/.intelligence/working/
**/.intelligence/cache/
**/.opencode/intelligence/indexes/
**/.opencode/intelligence/cache/

# Dependencies and outputs
node_modules/
dist/
build/
coverage/
.nyc_output/

# OS and editors
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# Git (keep .github directory)
.git/
*.git
.gitattributes

# Temporary files
*.tmp
*.temp
*.bak
*-bak-*
*.original

# Build artifacts
*.o
*.obj
*.dll
*.exe

# Test scripts (empty placeholders)
test-*.ps1

# AI Environment generated files
**/.ai-env/*.json
!**/.ai-env/environment.json.example
!**/.ai-env/project-manifest.json.example
!**/.ai-env/retrieval-policy.json.example

# Retrieval index and graph (generated)
**/.intelligence/graph.jsonl
**/.intelligence/index.json
!**/.intelligence/manifest.json

# Bootstrap and onboarding state
**/.bootstrap/active-task.txt
**/.bootstrap/session-*.json

# Reports (keep .md, ignore .json)
reports/*.json
!reports/*.md

# Tool output and dumps
**/*.dump
**/*.trace
**/tool-output/

# Runtime managed backups (keep source backups)
**/runtime/backups/managed/
!**/runtime/backups/managed/*.md

# Package manager lock files (use pnpm)
package-lock.json
npm-shrinkwrap.json
yarn.lock

# Script output logs
**/scripts/output/
**/scripts/logs/
