{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opencode-global:contracts:project-manifest:v1",
  "title": "Project Manifest Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "project_id",
    "repositories"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "version": {
      "const": "1"
    },
    "project_id": {
      "$ref": "#/$defs/portableId"
    },
    "repositories": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/repository"
      }
    },
    "policy": {
      "$ref": "#/$defs/policy"
    }
  },
  "$defs": {
    "portableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$"
    },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?:\\.|(?!/)(?!~)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*)$"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "path"
      ],
      "properties": {
        "repository_id": {
          "$ref": "#/$defs/portableId"
        },
        "path": {
          "$ref": "#/$defs/portablePath"
        },
        "allowed_read_roots": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true,
          "default": ["."],
          "items": {
            "$ref": "#/$defs/portablePath"
          }
        },
        "allowed_write_roots": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true,
          "default": [],
          "items": {
            "$ref": "#/$defs/portablePath"
          }
        },
        "protected_paths": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "uniqueItems": true,
          "default": [],
          "items": {
            "$ref": "#/$defs/portablePath"
          }
        },
        "gates": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "default": [],
          "items": {
            "$ref": "#/$defs/gate"
          }
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command", "working_directory", "timeout_seconds", "required"],
      "properties": {
        "id": { "$ref": "#/$defs/portableId" },
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 256
          }
        },
        "working_directory": { "$ref": "#/$defs/portablePath" },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "required": { "type": "boolean" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_writers_per_repository": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "max_read_only_child_tasks_per_session": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      }
    }
  }
}