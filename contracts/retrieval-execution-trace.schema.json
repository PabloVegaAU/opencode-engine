{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opencode-global:contracts:retrieval-execution-trace:v1",
  "title": "Retrieval Execution Trace Contract",
  "description": "Per-execution phase trace. Emitted only via --TracePath / --WriteTrace. Path is restricted to allowed subdirectories under the global runtime or to a path validated via Resolve-Path that is not inside the project and not outside the authorized roots. The trace distinguishes logical adapter calls (one per adapter execution over the multi-repo scope) from provider_process_invocations (one per repo per logical call). call_log.logical_calls has maxItems equivalent to call_budget; call_log.provider_processes is the per-repo process log. reason_code is a $ref to the frozen catalogue.",
  "type": "object",
  "required": [
    "schema_version",
    "trace_id",
    "started_at",
    "finished_at",
    "duration_ms",
    "phases",
    "events",
    "logical_calls",
    "provider_processes",
    "focused_reads"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "trace_id": { "type": "string", "pattern": "^[0-9a-fA-F-]{36}$" },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "phases": {
      "type": "object",
      "required": ["plan", "repository_state", "preflight", "equivalence", "adapter", "normalize", "budget", "result"],
      "additionalProperties": false,
      "properties": {
        "plan": { "type": "integer", "minimum": 0 },
        "repository_state": { "type": "integer", "minimum": 0 },
        "preflight": { "type": "integer", "minimum": 0 },
        "equivalence": { "type": "integer", "minimum": 0 },
        "adapter": { "type": "integer", "minimum": 0 },
        "normalize": { "type": "integer", "minimum": 0 },
        "budget": { "type": "integer", "minimum": 0 },
        "result": { "type": "integer", "minimum": 0 }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["phase", "reason_code", "at"],
        "additionalProperties": false,
        "properties": {
          "phase": {
            "type": "string",
            "enum": ["plan", "repository_state", "preflight", "equivalence", "adapter", "normalize", "budget", "result", "focused_read"]
          },
          "reason_code": { "$ref": "urn:opencode-global:contracts:retrieval-execution-reason-codes:v1" },
          "at": { "type": "string", "format": "date-time" },
          "detail": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "logical_calls": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["provider", "started_at", "duration_ms", "exit_was_success", "provider_process_ids"],
        "additionalProperties": false,
        "properties": {
          "provider": { "type": "string", "enum": ["ripgrep", "git_grep", "filesystem"] },
          "is_fallback": { "type": "boolean" },
          "started_at": { "type": "string", "format": "date-time" },
          "duration_ms": { "type": "integer", "minimum": 0 },
          "exit_was_success": { "type": "boolean" },
          "stdout_chars": { "type": "integer", "minimum": 0 },
          "provider_process_ids": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[0-9a-f-]+$" },
            "description": "Stable process IDs, one per repo. Cross-references into provider_processes."
          },
          "is_focused_read": {
            "type": "boolean",
            "description": "true when this logical call is a focused read (progressive disclosure expansion). Always counted."
          }
        }
      }
    },
    "provider_processes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["process_id", "provider", "repository_id", "cwd", "args", "started_at", "duration_ms", "exit_code", "stdout_chars"],
        "additionalProperties": false,
        "properties": {
          "process_id": { "type": "string", "pattern": "^[0-9a-f-]+$" },
          "provider": { "type": "string", "enum": ["ripgrep", "git_grep", "filesystem"] },
          "repository_id": { "type": "string" },
          "cwd": { "type": "string", "description": "Resolved repo root, POSIX path." },
          "args": { "type": "array", "items": { "type": "string" } },
          "started_at": { "type": "string", "format": "date-time" },
          "duration_ms": { "type": "integer", "minimum": 0 },
          "exit_code": { "type": "integer" },
          "stdout_chars": { "type": "integer", "minimum": 0 },
          "stderr_present": { "type": "boolean" }
        }
      }
    },
    "focused_reads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["preview_token", "started_at", "duration_ms", "char_count", "scope_fingerprint"],
        "additionalProperties": false,
        "properties": {
          "preview_token": { "type": "string" },
          "scope_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Scope fingerprint re-validated at expansion time." },
          "allowed_root_check": { "type": "string", "enum": ["passed", "failed"] },
          "deny_glob_check": { "type": "string", "enum": ["passed", "failed"] },
          "started_at": { "type": "string", "format": "date-time" },
          "duration_ms": { "type": "integer", "minimum": 0 },
          "char_count": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
