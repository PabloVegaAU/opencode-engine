{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opencode-global:contracts:runtime-records:v1",
  "title": "Runtime Records v1",
  "oneOf": [
    { "$ref": "#/$defs/mission" },
    { "$ref": "#/$defs/repository_unit" },
    { "$ref": "#/$defs/task" },
    { "$ref": "#/$defs/session_binding" },
    { "$ref": "#/$defs/lease" },
    { "$ref": "#/$defs/worktree_allocation" },
    { "$ref": "#/$defs/integration_job" },
    { "$ref": "#/$defs/event" }
  ],
  "$defs": {
    "portableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$"
    },
    "prefixedUuid": {
      "type": "string",
      "pattern": "^[a-z]{3}_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "operationId": {
      "type": "string",
      "pattern": "^op_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "environmentId": {
      "type": "string",
      "pattern": "^env_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "gitOid": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?:\\.|(?!/)(?!~)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)(?!.*/$)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*)$"
    },
    "nonEmptyNoNul": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$"
    },
    "branchOrRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "eventType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(?:\\.[a-z0-9]+)*$"
    },
    "pathArray": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/portablePath" }
    },
    "taskIdArray": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^tsk_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      }
    },
    "base": {
      "type": "object",
      "required": ["record_type", "version", "environment_id", "operation_id", "created_at", "updated_at"],
      "properties": {
        "record_type": { "type": "string" },
        "version": { "const": "1" },
        "environment_id": { "$ref": "#/$defs/environmentId" },
        "operation_id": { "$ref": "#/$defs/operationId" },
        "created_at": { "$ref": "#/$defs/utcTimestamp" },
        "updated_at": { "$ref": "#/$defs/utcTimestamp" }
      }
    },
    "mission": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["record_type", "version", "environment_id", "operation_id", "created_at", "updated_at", "mission_id", "project_id", "title", "state"],
          "properties": {
            "record_type": { "const": "mission" },
            "version": { "const": "1" },
            "environment_id": { "$ref": "#/$defs/environmentId" },
            "operation_id": { "$ref": "#/$defs/operationId" },
            "created_at": { "$ref": "#/$defs/utcTimestamp" },
            "updated_at": { "$ref": "#/$defs/utcTimestamp" },
            "mission_id": { "type": "string", "pattern": "^mis_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
            "project_id": { "$ref": "#/$defs/portableId" },
            "title": { "type": "string", "minLength": 1, "maxLength": 200 },
            "state": { "enum": ["planned", "active", "blocked", "completed", "failed", "cancelled"] }
          }
        }
      ]
    },
    "repository_unit": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["record_type", "version", "environment_id", "operation_id", "created_at", "updated_at", "repository_unit_id", "mission_id", "project_id", "repository_id", "manifest_path", "canonical_repository_path", "base_commit", "state"],
          "properties": {
            "record_type": { "const": "repository_unit" },
            "version": { "const": "1" },
            "environment_id": { "$ref": "#/$defs/environmentId" },
            "operation_id": { "$ref": "#/$defs/operationId" },
            "created_at": { "$ref": "#/$defs/utcTimestamp" },
            "updated_at": { "$ref": "#/$defs/utcTimestamp" },
            "repository_unit_id": { "type": "string", "pattern": "^rpu_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
            "mission_id": { "type": "string", "pattern": "^mis_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
            "project_id": { "$ref": "#/$defs/portableId" },
            "repository_id": { "$ref": "#/$defs/portableId" },
            "manifest_path": { "$ref": "#/$defs/portablePath" },
            "canonical_repository_path": { "$ref": "#/$defs/nonEmptyNoNul" },
            "base_commit": { "$ref": "#/$defs/gitOid" },
            "state": { "enum": ["planned", "ready", "blocked", "completed", "failed", "cancelled"] }
          }
        }
      ]
    },
    "task": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["record_type", "version", "environment_id", "operation_id", "created_at", "updated_at", "task_id", "mission_id", "repository_unit_id", "repository_id", "title", "kind", "state", "base_commit", "read_scope", "write_scope", "exclusive_scope", "protected_paths", "dependency_task_ids", "attempt"],
          "properties": {
            "record_type": { "const": "task" },
            "version": { "const": "1" },
            "environment_id": { "$ref": "#/$defs/environmentId" },
            "operation_id": { "$ref": "#/$defs/operationId" },
            "created_at": { "$ref": "#/$defs/utcTimestamp" },
            "updated_at": { "$ref": "#/$defs/utcTimestamp" },
            "task_id": { "type": "string", "pattern": "^tsk_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
            "mission_id": { "type": "string", "pattern": "^mis_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
            "repository_unit_id": { "type": "string", "pattern": "^rpu_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
            "repository_id": { "$ref": "#/$defs/portableId" },
            "title": { "type": "string", "minLength": 1, "maxLength": 200 },
            "kind": { "enum": ["read", "write"] },
            "state": { "enum": ["planned", "ready", "running", "validating", "integration_ready", "integrating", "blocked", "completed", "failed", "cancelled", "interrupted"] },
            "base_commit": { "$ref": "#/$defs/gitOid" },
            "read_scope": { "$ref": "#/$defs/pathArray" },
            "write_scope": { "$ref": "#/$defs/pathArray" },
            "exclusive_scope": { "$ref": "#/$defs/pathArray" },
            "protected_paths": { "$ref": "#/$defs/pathArray" },
            "instruction_path": { "$ref": "#/$defs/portablePath" },
            "instruction_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "dependency_task_ids": { "$ref": "#/$defs/taskIdArray" },
            "attempt": { "type": "integer", "minimum": 0, "maximum": 100 }
          },
          "dependentRequired": {
            "instruction_path": ["instruction_sha256"],
            "instruction_sha256": ["instruction_path"]
          }
        }
      ]
    },
    "session_binding": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["record_type", "version", "environment_id", "operation_id", "created_at", "updated_at", "session_binding_id", "task_id", "adapter_id", "external_session_id", "mode", "state"],
          "properties": {
            "record_type": { "const": "session_binding" },
            "version": { "const": "1" },
            "environment_id": { "$ref": "#/$defs/environmentId" },
            "operation_id": { "$ref": "#/$defs/operationId" },
            "created_at": { "$ref": "#/$defs/utcTimestamp" },
            "updated_at": { "$ref": "#/$defs/utcTimestamp" },
            "session_binding_id": { "type": "string", "pattern": "^sbn_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
            "task_id": { "type": "string", "pattern": "^tsk_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
            "adapter_id": { "$ref": "#/$defs/portableId" },
            "external_session_id": {
              "oneOf": [
                { "$ref": "#/$defs/nonEmptyNoNul" },
                { "type": "null" }
              ]
            },
            "mode": { "enum": ["primary", "child", "operator"] },
            "state": { "enum": ["bound", "active", "completed", "failed", "detached"] }
          }
        }
      ]
    },
    "lease": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["record_type", "version", "environment_id", "operation_id", "created_at", "updated_at", "lease_id", "task_id", "repository_unit_id", "holder_session_binding_id", "fencing_token", "state", "acquired_at", "heartbeat_at", "expires_at", "released_at"],
          "properties": {
            "record_type": { "const": "lease" },
            "version": { "const": "1" },
            "environment_id": { "$ref": "#/$defs/environmentId" },
            "operation_id": { "$ref": "#/$defs/operationId" },
            "created_at": { "$ref": "#/$defs/utcTimestamp" },
            "updated_at": { "$ref": "#/$defs/utcTimestamp" },
            "lease_id": { "type": "string", "pattern": "^lea_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
            "task_id": { "type": "string", "pattern": "^tsk_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
            "repository_unit_id": { "type": "string", "pattern": "^rpu_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
            "holder_session_binding_id": { "type": "string", "pattern": "^sbn_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
            "fencing_token": { "type": "integer", "minimum": 1 },
            "state": { "enum": ["active", "released", "expired", "revoked"] },
            "acquired_at": { "$ref": "#/$defs/utcTimestamp" },
            "heartbeat_at": { "$ref": "#/$defs/utcTimestamp" },
            "expires_at": { "$ref": "#/$defs/utcTimestamp" },
            "released_at": {
              "oneOf": [
                { "$ref": "#/$defs/utcTimestamp" },
                { "type": "null" }
              ]
            }
          }
        }
      ]
    },
    "worktree_allocation": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["record_type", "version", "environment_id", "operation_id", "created_at", "updated_at", "worktree_allocation_id", "task_id", "repository_unit_id", "lease_id", "fencing_token", "canonical_repository_path", "worktree_path", "branch", "base_commit", "head_commit", "state"],
          "properties": {
            "record_type": { "const": "worktree_allocation" },
            "version": { "const": "1" },
            "environment_id": { "$ref": "#/$defs/environmentId" },
            "operation_id": { "$ref": "#/$defs/operationId" },
            "created_at": { "$ref": "#/$defs/utcTimestamp" },
            "updated_at": { "$ref": "#/$defs/utcTimestamp" },
            "worktree_allocation_id": { "type": "string", "pattern": "^wta_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
            "task_id": { "type": "string", "pattern": "^tsk_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
            "repository_unit_id": { "type": "string", "pattern": "^rpu_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
            "lease_id": { "type": "string", "pattern": "^lea_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
            "fencing_token": { "type": "integer", "minimum": 1 },
            "canonical_repository_path": { "$ref": "#/$defs/nonEmptyNoNul" },
            "worktree_path": { "$ref": "#/$defs/nonEmptyNoNul" },
            "branch": { "$ref": "#/$defs/branchOrRef" },
            "base_commit": { "$ref": "#/$defs/gitOid" },
            "head_commit": {
              "oneOf": [
                { "$ref": "#/$defs/gitOid" },
                { "type": "null" }
              ]
            },
            "state": { "enum": ["allocated", "active", "dirty", "blocked", "missing", "recovery_required", "released"] }
          }
        }
      ]
    },
    "integration_job": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["record_type", "version", "environment_id", "operation_id", "created_at", "updated_at", "integration_job_id", "mission_id", "repository_unit_id", "repository_id", "source_task_ids", "source_head", "base_commit", "target_ref", "state", "result_tree", "applied_commit", "conflict_paths"],
          "properties": {
            "record_type": { "const": "integration_job" },
            "version": { "const": "1" },
            "environment_id": { "$ref": "#/$defs/environmentId" },
            "operation_id": { "$ref": "#/$defs/operationId" },
            "created_at": { "$ref": "#/$defs/utcTimestamp" },
            "updated_at": { "$ref": "#/$defs/utcTimestamp" },
            "integration_job_id": { "type": "string", "pattern": "^inj_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
            "mission_id": { "type": "string", "pattern": "^mis_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
            "repository_unit_id": { "type": "string", "pattern": "^rpu_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
            "repository_id": { "$ref": "#/$defs/portableId" },
            "source_task_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^tsk_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" }
            },
            "source_head": { "$ref": "#/$defs/gitOid" },
            "base_commit": { "$ref": "#/$defs/gitOid" },
            "target_ref": { "$ref": "#/$defs/branchOrRef" },
            "state": { "enum": ["queued", "preflighting", "ready_for_approval", "integrating", "conflicted", "completed", "failed", "cancelled", "interrupted"] },
            "result_tree": {
              "oneOf": [
                { "$ref": "#/$defs/gitOid" },
                { "type": "null" }
              ]
            },
            "applied_commit": {
              "oneOf": [
                { "$ref": "#/$defs/gitOid" },
                { "type": "null" }
              ]
            },
            "conflict_paths": { "$ref": "#/$defs/pathArray" }
          }
        }
      ]
    },
    "eventScalar": {
      "oneOf": [
        { "type": "string", "maxLength": 500 },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" }
      ]
    },
    "event": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["record_type", "version", "environment_id", "operation_id", "created_at", "updated_at", "event_id", "aggregate_type", "aggregate_id", "event_type", "actor_type", "actor_id", "data"],
          "properties": {
            "record_type": { "const": "event" },
            "version": { "const": "1" },
            "environment_id": { "$ref": "#/$defs/environmentId" },
            "operation_id": { "$ref": "#/$defs/operationId" },
            "created_at": { "$ref": "#/$defs/utcTimestamp" },
            "updated_at": { "$ref": "#/$defs/utcTimestamp" },
            "event_id": { "type": "string", "pattern": "^evt_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
            "aggregate_type": { "enum": ["mission", "repository_unit", "task", "session_binding", "lease", "worktree_allocation", "integration_job"] },
            "aggregate_id": { "$ref": "#/$defs/nonEmptyNoNul" },
            "event_type": { "$ref": "#/$defs/eventType" },
            "actor_type": { "enum": ["coordinator", "operator", "adapter"] },
            "actor_id": {
              "oneOf": [
                { "$ref": "#/$defs/nonEmptyNoNul" },
                { "type": "null" }
              ]
            },
            "data": {
              "type": "object",
              "maxProperties": 32,
              "additionalProperties": { "$ref": "#/$defs/eventScalar" }
            }
          }
        }
      ]
    }
  }
}