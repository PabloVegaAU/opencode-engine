{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opencode-global:contracts:update-run:v1",
  "title": "Update Run Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "plan_id", "started_at", "completed_at", "status", "operations", "backup_manifest_path", "journal_entry_id"],
  "properties": {
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "plan_id": {
      "type": "string",
      "format": "uuid"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "status": {
      "enum": ["in_progress", "completed", "rolled_back", "failed"]
    },
    "operations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/operation"
      }
    },
    "backup_manifest_path": {
      "type": "string"
    },
    "journal_entry_id": {
      "type": "string",
      "format": "uuid"
    }
  },
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path", "status", "error"],
      "properties": {
        "type": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "status": {
          "enum": ["pending", "success", "failed", "rolled_back"]
        },
        "error": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
