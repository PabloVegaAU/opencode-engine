{
  "$schema": "https://opencode.ai/config.json",
  "share": "manual",
  "permission": {
    "read": {
      "*": "allow",
      ".env": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      ".secrets/**": "deny",
      "**/.secrets/**": "deny",
      "**/secrets/**": "deny"
    },
    "edit": {
      "*": "allow",
      ".env": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      ".secrets/**": "deny",
      "**/.secrets/**": "deny",
      "**/secrets/**": "deny"
    },
    "external_directory": {
      "*": "deny"
    },
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git rev-parse*": "allow",
      "git branch --show-current*": "allow",
      "rm *": "deny",
      "rmdir *": "deny",
      "rd *": "deny",
      "del *": "deny",
      "erase *": "deny",
      "Remove-Item *": "deny",
      "git reset*": "deny",
      "git clean*": "deny",
      "git checkout*": "deny",
      "git restore*": "deny",
      "git switch*": "deny",
      "git stash*": "deny",
      "git rebase*": "deny",
      "git worktree*": "deny",
      "git push*": "deny"
    },
    "skill": "allow",
    "doom_loop": "deny"
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 10
  },
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 8192
  },
  "snapshot": true,
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      "__pycache__/**",
      ".venv/**"
    ]
  }
}
